// --- Разбиение строки на слова ---
function SplitCommand(const Line: string): TStringArray;
var
  k, start, wordCount: Integer;
  words: TStringArray;
begin
  SetLength(words, 0);
  wordCount := 0;
  start := 1;
  for k := 1 to Length(Line) do
  begin
    if Line[k] = ' ' then
    begin
      if k > start then
      begin
        SetLength(words, wordCount + 1);
        words[wordCount] := Copy(Line, start, k - start);
        Inc(wordCount);
        start := k + 1;
      end;
    end;
  end;
  if start <= Length(Line) then
  begin
    SetLength(words, wordCount + 1);
    words[wordCount] := Copy(Line, start, Length(Line) - start + 1);
  end;
  Result := words;
end;

function GetParamType(const Args: string): uint8;
begin
  if Pos('/t=i', UpperCase(Args)) > 0 then
    Result := 0
  else if Pos('/t=r', UpperCase(Args)) > 0 then
    Result := 1
  else if Pos('/t=c', UpperCase(Args)) > 0 then
    Result := 2
  else
    Result := G_Type;
end;

// --- Получить целочисленный параметр /N=1000 ---
function GetParamI(const Args: string; const Param: string): Integer;
var
  posFind, startPos: Integer;
  argStr: string;
begin
  Result := 0;
  posFind := Pos('/' + Param, UpperCase(Args));
  if posFind > 0 then
  begin
    startPos := posFind + Length(Param) + 1;
    while (startPos <= Length(Args)) and (Args[startPos] <> '/') do
      Inc(startPos);
    argStr := Copy(Args, posFind + Length(Param) + 1,
      startPos - posFind - Length(Param) - 1);
    try
      Result := StrToIntDef(argStr, 0);
    except
      Result := 0;
    end;
  end;
end;

// --- Получить вещественный параметр /L=0.5 ---
function GetParamF(const Args: string; const Param: string): Double;
var
  posFind, startPos: Integer;
  argStr: string;
begin
  Result := 0.0;
  posFind := Pos('/' + Param, UpperCase(Args));
  if posFind > 0 then
  begin
    startPos := posFind + Length(Param) + 1;
    while (startPos <= Length(Args)) and (Args[startPos] <> '/') do
      Inc(startPos);
    argStr := Copy(Args, posFind + Length(Param) + 1,
      startPos - posFind - Length(Param) - 1);
    try
      Result := StrToFloatDef(argStr, 0.0);
    except
      Result := 0.0;
    end;
  end;
end;

// --- Показать параметры ---
procedure ShowParams;
begin
  Writeln('--- Параметры системы ---');
