// --- Получить числовое значение по символу-ключу (парсим /N=1000) ---
// Считаем ключ первой буквой после слеша (например N из /N=)
function GetParamValue(const Args: string; const ParamKey: char): Integer;
var
  i, j: Integer;
  foundStart: Boolean;
begin
  Result := 0;
  i := 1;
  foundStart := False;
  // Ищем сначала слэш
  while i <= Length(Args) do
  begin
    if Args[i] = '/' then
    begin
      // Следующий символ — это ключ
      if (i + 1 <= Length(Args)) and
        (UpperCase(Args[i + 1])[1] = UpperCase(ParamKey)) then
      begin
        // Нашли ключ, теперь ищем =
        foundStart := True;
        j := i + 2; // Пропускаем /КЛЮЧ
        // Находим знак '='
        while (j <= Length(Args)) and (Args[j] <> '=') do
          Inc(j);
        if j <= Length(Args) then
        begin
          // Теперь читаем значение от символа после '=' до слэша или конца строки
          Inc(j); // Пропускаем '='
          while (j <= Length(Args)) and (Args[j] <> '/') do
            Inc(j);
          try
            Result := StrToIntDef(Copy(Args, i + 2, j - i - 2), 0);
          except
            Result := 0;
          end;
        end;
      end;
    end;
    Inc(i);
  end;
end;

// --- Получить буквенное значение по символу-ключу (парсим /T=R) ---
function GetCharValue(const Args: string; const ParamKey: char): char;
var
  i: Integer;
begin
  Result := ' ';
  i := 1;
  while i <= Length(Args) do
  begin
    if Args[i] = '/' then
    begin
      // Следующий символ — это ключ
      if (i + 1 <= Length(Args)) and
        (UpperCase(Args[i + 1])[1] = UpperCase(ParamKey)) then
      begin
        // Нашли ключ, теперь ищем =
        var
        j := i + 2;
        while (j <= Length(Args)) and (Args[j] <> '=') do
          Inc(j);
        if j <= Length(Args) then
        begin
          // Значение после знака равно
          Inc(j);
          // Берем один символ (или больше, если нужно)
          Result := Args[j];
        end;
      end;
    end;
    Inc(i);
  end;
end;

procedure TreeView(const ar: TIntArray; b: uint32; w: uint32);
var
  i, l, j: uint32;
  k, k1: uint8;
begin
  k := 0;
  l := w - b + 1;
  // write(l);
  while ((1 shl k) < l) do
  begin
    // write(k);
    Inc(k);
  end;
  k1 := k;
  // dec(k);
  // write('step = ', k)
  j := 0;
  for i := b to w do
  begin
    if j = 0 then
      write(StringOfChar(' ', 1 shl k));

    Inc(j);
    write(ar[i]:2);
    write(StringOfChar(' ', (1 shl (k + 1) - 2)));
    if (j = (1 shl (k1 - k))) then
    begin
      Writeln;
      writeln;
      dec(k);
      j := 0;

    end;
  end;

end;

