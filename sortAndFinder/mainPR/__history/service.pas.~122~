  Writeln('Size   = ', G_N);
  Writeln('MinVal = ', G_L);
  Writeln('MaxVal = ', G_R);
  Writeln('Seed   = ', G_Seed);
  Writeln('-------------------------');
end;

// --- Генерация Int массива ---
procedure GenerateArray(var Arr: TIntArray;
  Size, MinVal, MaxVal, Seed: Integer);
var
  i: Integer;
begin
  SetLength(Arr, Size);
  RandSeed := Seed;
  for i := 0 to Size - 1 do
    Arr[i] := Random(MaxVal - MinVal + 1) + MinVal;
end;

// --- Генерация Real массива ---
procedure GenerateArray(var Arr: TRealArray;
  Size, MinVal, MaxVal, Seed: Integer);
var
  i: Integer;
begin
  SetLength(Arr, Size);
  RandSeed := Seed;
  for i := 0 to Size - 1 do
    Arr[i] := Random * (MaxVal - MinVal) + MinVal;
end;

// --- Генерация Char массива ---
procedure GenerateArray(var Arr: TCharArray; Size, Seed: Integer);
var
  i: Integer;
begin
  SetLength(Arr, Size);
  RandSeed := Seed;
  for i := 0 to Size - 1 do
    Arr[i] := AnsiChar(Random(ord('z') - ord('a') + 1) + ord('a'));
end;

// --- Вывод первых N элементов (Int) ---
procedure PrintArray(const Arr: TIntArray; Count: Integer);
var
  i, j: Integer;
begin
  j := 0;
  for i := 0 to Min(Count - 1, Length(Arr) - 1) do
  begin
    Write(Arr[i]:4);
    Inc(j);
    if j mod 10 = 0 then
      Writeln;
  end;
  if j mod 10 <> 0 then
    Writeln;
end;

// --- Вывод первых N элементов (Real) ---
procedure PrintArray(const Arr: TRealArray; Count: Integer);
var
  i, j: Integer;
begin
  j := 0;
  for i := 0 to Min(Count - 1, Length(Arr) - 1) do
  begin
    Write(Arr[i]:8:2, ' ');
    Inc(j);
    if j mod 10 = 0 then
      Writeln;
  end;
  if j mod 10 <> 0 then
    Writeln;
end;

// --- Вывод первых N элементов (Char) ---
procedure PrintArray(const Arr: TCharArray; Count: Integer);
var
  i, j: Integer;
begin
  j := 0;
  for i := 0 to Min(Count - 1, Length(Arr) - 1) do
  begin
    Write(Arr[i]);
    Inc(j);
    if j mod 50 = 0 then
      Writeln;
  end;
  if j mod 50 <> 0 then
    Writeln;
end;

// --- Вывод последних N элементов (Int) ---
procedure PrintLast(const Arr: TIntArray; Count: Integer);
var
  i, StartIdx: Integer;
begin
  StartIdx := Max(0, Length(Arr) - Count);
  for i := StartIdx to Length(Arr) - 1 do
  begin
    Write(Arr[i]:4);
    if (i - StartIdx + 1) mod 10 = 0 then
      Writeln;
  end;
  if (Length(Arr) - StartIdx) mod 10 <> 0 then
    Writeln;
end;

// --- Вывод последних N элементов (Real) ---
procedure PrintLast(const Arr: TRealArray; Count: Integer);
var
  i, StartIdx: Integer;
begin
  StartIdx := Max(0, Length(Arr) - Count);
  for i := StartIdx to Length(Arr) - 1 do
  begin
    Write(Arr[i]:8:2, ' ');
    if (i - StartIdx + 1) mod 10 = 0 then
      Writeln;
  end;
  if (Length(Arr) - StartIdx) mod 10 <> 0 then
    Writeln;
end;

// --- Вывод последних N элементов (Char) ---
procedure PrintLast(const Arr: TCharArray; Count: Integer);
var
  i, StartIdx: Integer;
begin
  StartIdx := Max(0, Length(Arr) - Count);
  for i := StartIdx to Length(Arr) - 1 do
    Write(Arr[i]);
  Writeln;
end;

