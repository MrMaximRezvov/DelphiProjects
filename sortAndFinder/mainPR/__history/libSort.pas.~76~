// ======================================
// BINARY SEARCH
// ======================================
function BinSearchInt(const Arr: TIntArray; Left, Right, Key: Integer): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
      Left := Mid + 1
    else
      Right := Mid - 1;
  end;
  Result := Left;
end;

function BinSearchReal(const Arr: TRealArray; Left, Right: Integer;
  Key: Real): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
      Left := Mid + 1
    else
      Right := Mid - 1;
  end;
  Result := Left;
end;

function BinSearchChar(const Arr: TCharArray; Left, Right: Integer;
  Key: AnsiChar): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
      Left := Mid + 1
    else
      Right := Mid - 1;
  end;
  Result := Left;
end;

// ======================================
// BINARY INSERTION SORT С MOVE
// ======================================
procedure BinaryInsertionSort(var Arr: TIntArray);
var
  i, pos, Key, shift, n: Integer;
begin
  n := Length(Arr);
  for i := 1 to n - 1 do
  begin
    Key := Arr[i];
    pos := BinSearchInt(Arr, 0, i - 1, Key);
    if i <> pos then
    begin
      shift := i - pos;
      Move(Arr[pos], Arr[pos + 1], shift * SizeOf(Integer));
      Arr[pos] := Key;
    end;
  end;
end;

