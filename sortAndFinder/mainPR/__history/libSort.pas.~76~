procedure GnomeSortOptimized(var Arr: TIntArray);
var
  i, j, Key: Integer;
  n: Integer;
begin
  i := 1;
  j := 2;
  n := Length(Arr);
  while i < n do
  begin
    Key := Arr[i];
    if Arr[i - 1] <= Key then
    begin
      i := j;
      Inc(j);
    end
    else
    begin
      Arr[i] := Arr[i - 1];
      Arr[i - 1] := Key;
      Dec(i);
      if i = 0 then
      begin
        i := j;
        Inc(j);
      end;
    end;
  end;
end;

