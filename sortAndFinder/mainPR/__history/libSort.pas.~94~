procedure sift_down(var ar: TIntArray; n: Integer);
var
  i, largest, Left, Right, temp: Integer;
begin
  i := 0;
  while True do
  begin
    largest := i;
    Left := (i shl 1) + 1;
    Right := (i shl 1) + 2;

    if (Left < n) and (ar[Left] > ar[largest]) then
      largest := Left;

    if (Right < n) and (ar[Right] > ar[largest]) then
      largest := Right;

    if largest = i then
      Break;

    temp := ar[i];
    ar[i] := ar[largest];
    ar[largest] := temp;

    i := largest;
  end;
end;

