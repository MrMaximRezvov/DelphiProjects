procedure heapsort1(var m: TIntArray);
var
  s, temp: Integer;
  i: UInt32;
begin
  // Этап 1: Построение кучи
  for i := 1 to High(m) do
    sift_up(m, i);

  // Этап 2: Сортировка
  s := Length(m);
  while s > 1 do
  begin
    // Меняем местами корень (максимум) и последний элемент
    temp := m[0];
    m[0] := m[s - 1];
    m[s - 1] := temp;

    // Уменьшаем размер кучи
    Dec(s);

    // Восстанавливаем кучу
    sift_down1(m, s);
  end;
end;

