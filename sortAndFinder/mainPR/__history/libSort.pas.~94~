procedure sift_up(var ar: TIntArray; i: Integer);
var
  parent: Integer;
  temp: Integer;
begin
  while i > 0 do
  begin
    parent := (i - 1) shr 1;

    if ar[i] > ar[parent] then
    begin
      temp := ar[i];
      ar[i] := ar[parent];
      ar[parent] := temp;

      i := parent;
    end
    else
      Break;
  end;
end;

procedure BuildHeap(var ar: TIntArray; n: Integer);
var
  i: Integer;
begin
  for i := 1 to n - 1 do
    sift_up(ar, i);
end;

