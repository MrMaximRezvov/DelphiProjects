// ======================================

procedure QSortHoare(var Arr: TIntArray);
var
  i, j, x, y: Integer;
  procedure QS(L, R: Integer);
  begin
    i := L;
    j := R;
    x := Arr[(i + j) shr 1]; // pivot
    repeat
      while Arr[i] < x do
      begin
        Inc(i);
      end;
      while Arr[j] > x do
      begin
        Dec(j);
      end;
      if i <= j then
      begin
        y := Arr[i];
        Arr[i] := Arr[j];
        Arr[j] := y;
        Inc(i);
        Dec(j);
      end;
    until i > j;
    if j > L then
      QS(L, j);
    if i < R then
      QS(i, R);
  end;

begin
  if Length(Arr) > 0 then
    QS(0, High(Arr));
end;

