// ======================================
// SHELL SORT
// ======================================
procedure SortShell(var Arr: TIntArray);
var
  i, j, x, d, n: Integer;
begin
  n := Length(Arr);
  if n = 0 then
    raise Exception.Create('Массив отсутствует!');
  d := n shr 1;
  while d > 0 do
  begin
    for i := d to n - 1 do
    begin
      j := i;
      while (j >= d) and (Arr[j - d] > Arr[j]) do
      begin
        x := Arr[j];
        Arr[j] := Arr[j - d];
        Arr[j - d] := x;
        j := j - d;
      end;
    end;
    d := d shr 1;
  end;
end;

