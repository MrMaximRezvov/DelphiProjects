procedure GnomeSort(var Arr: TIntArray);
var
  i, temp: Integer;
begin
  i := 0;
  while i < Length(Arr) do
  begin
    if (i = 0) or (Arr[i - 1] <= Arr[i]) then
      Inc(i)
    else
    begin
      temp := Arr[i];
      Arr[i] := Arr[i - 1];
      Arr[i - 1] := temp;
      Dec(i);
    end;
  end;
end;

