    largest := i;
    Left := (i shl 1) + 1;
    Right := (i shl 1) + 2;

    if (Left < s) and (a[Left] > a[largest]) then
      largest := Left;

    if (Right < s) and (a[Right] > a[largest]) then
      largest := Right;

    if largest = i then
      Break;

    temp := a[i];
    a[i] := a[largest];
    a[largest] := temp;

    i := largest;
  end;
end;

procedure heapsort1(var m: TRealArray);
var
  s: Integer;
  temp: Real;
  i: UInt32;
begin
  for i := 1 to High(m) do
    sift_up(m, i);

  s := Length(m);
  while s > 1 do
  begin
    temp := m[0];
    m[0] := m[s - 1];
    m[s - 1] := temp;

    Dec(s);
    sift_down1(m, s);
  end;
end;

