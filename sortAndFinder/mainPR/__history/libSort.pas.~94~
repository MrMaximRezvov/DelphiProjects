// ======================================
// BINARY SEARCH
// ======================================
function BinSearchInt(const Arr: TIntArray; Left, Right, Key: Integer): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
      Left := Mid + 1
    else
      Right := Mid - 1;
  end;
  Result := Left;
end;

function BinSearchReal(const Arr: TRealArray; Left, Right: Integer;
  Key: Real): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
      Left := Mid + 1
    else
      Right := Mid - 1;
  end;
  Result := Left;
end;

function BinSearchChar(const Arr: TCharArray; Left, Right: Integer;
  Key: AnsiChar): Integer;
var
  Mid: Integer;
begin
  while Left <= Right do
  begin
    Mid := Left + ((Right - Left) div 2);
    if Arr[Mid] < Key then
